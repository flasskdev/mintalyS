# --- server -----------------------------------------------------------------
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mintaly
DB_POOL=10

# comma separated list, or * to allow any origin (development only)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# set to 1 only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=0

# where "npm run build" puts the frontend (served by express in production)
PUBLIC_DIR=./dist
# folder with the real build archives, never exposed as static files
STORAGE_DIR=./storage

# SMTP — leave empty and the 6 digit codes are printed to the console
# and written to server/logs/mail.log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mintaly <no-reply@mintaly.local>
MAIL_LOG_FILE=./server/logs/mail.log

# security
CODE_TTL_MINUTES=15
CODE_MAX_ATTEMPTS=5
DOWNLOAD_TOKEN_TTL_MINUTES=15
MAX_LOGIN_ATTEMPTS=10
MAX_LOGIN_WINDOW_MINUTES=15
LOGIN_COOLDOWN_SECONDS=2
